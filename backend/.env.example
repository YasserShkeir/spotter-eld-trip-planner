# Copy to .env and fill in for local dev.
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default uses SQLite at backend/db.sqlite3. For Postgres on Render set DATABASE_URL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing / geocoding endpoints — defaults point to free public instances.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
HTTP_USER_AGENT=spotter-eld-planner/1.0 (your-email@example.com)
HTTP_TIMEOUT_SECONDS=20

DRF_ANON_THROTTLE=60/min
