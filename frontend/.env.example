# When the frontend is deployed (e.g. Vercel) it'll need to point at the
# backend's public URL. Locally you can leave this empty — Vite's dev server
# proxies /api/* to the backend (see vite.config.js).
VITE_API_BASE_URL=

# Optional: override the dev proxy target if your Django runs somewhere else
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
